{
  "compilerOptions": {
    "rootDir": "./",
    "outDir": "./dist",
    "allowJs": true,
    "checkJs": false,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "esnext",
    "lib": ["esnext"],
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "types": ["node"]
  },
  "include": [
    "middleware/**/*",
    "models/**/*",
    "src/**/*",
    "routes/**/*",
    "validators/**/*",
    "cluster.ts",
    "eventLoop.js",
    "server.ts",
    "transform.ts",
    "metrics.ts",
    "instrumentation.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "frontend",
    "coverage",
    "tests"
  ],
  "ts-node": {
    "logError": true,
    "pretty": true,
    "experimentalResolver": true
  }
}
