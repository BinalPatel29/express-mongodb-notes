{
  "compilerOptions": {
    "rootDir": "./",
    "outDir": "./dist",
    "allowJs": true,
    "checkJs": false,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "esnext",
    "lib": ["esnext"],
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    
    // FIXED: Added global type context support for the Node runtime environment
    "types": ["node"]
  },
  "include": [
    "middleware/**/*",
    "models/**/*",
    "src/**/*",
    "routes/**/*",
    "validators/**/*",
    "cluster.ts",
    "eventLoop.js",
    "server.ts",
    "transform.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "frontend",
    "coverage",
    "tests"
  ]
}
